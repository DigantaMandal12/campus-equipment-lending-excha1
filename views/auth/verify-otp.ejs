<%- include('../partials/header') %>

<div style="max-width: 480px; margin: 2.5rem auto;">
  <div class="card" style="box-shadow: var(--shadow-md);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">✉️</div>
      <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--dark); margin: 0 0 0.5rem 0;">Verify Your Campus Email</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0; line-height: 1.5;">
        A 6-digit verification code has been generated for:
        <br><strong style="color: var(--dark);"><%= typeof email !== 'undefined' ? email : 'your campus email' %></strong>
      </p>
    </div>

    <!-- On-Screen OTP Helper Banner for Local Testing / Direct Verification -->
    <% if (typeof otpHint !== 'undefined' && otpHint) { %>
      <div style="background: #eff6ff; border: 1.5px solid #93c5fd; border-radius: var(--radius-sm); padding: 1.1rem; margin-bottom: 1.5rem; text-align: center;">
        <div style="font-size: 0.78rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 0.5px;">
          🔑 Verification Code (Testing / Direct Preview)
        </div>
        <div style="font-size: 1.8rem; font-weight: 800; letter-spacing: 6px; color: var(--dark); font-family: monospace; margin: 0.35rem 0;">
          <%= otpHint %>
        </div>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.65rem 0;">
          Dispatched to <strong><%= typeof email !== 'undefined' ? email : 'your email' %></strong> (and logged in your server console).
        </p>
        <button type="button" class="btn btn-primary btn-sm" onclick="autoFillOtp('<%= otpHint %>')" style="font-size: 0.8rem; padding: 0.35rem 0.85rem;">
          ⚡ Auto-fill Code (<%= otpHint %>)
        </button>
      </div>

      <script>
        function autoFillOtp(code) {
          const input = document.getElementById('otp');
          if (input) {
            input.value = code;
            input.focus();
          }
        }
      </script>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-box alert-error">
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/auth/verify-otp" method="POST">
      <div class="form-group">
        <label for="otp" class="form-label" style="text-align: center; display: block; font-weight: 700;">Enter 6-Digit Code</label>
        <input 
          type="text" 
          id="otp" 
          name="otp" 
          class="form-control" 
          placeholder="000000" 
          maxlength="6" 
          pattern="\d{6}" 
          style="font-size: 1.5rem; letter-spacing: 8px; text-align: center; font-family: monospace; font-weight: 700;" 
          required 
          autofocus
        >
      </div>

      <button type="submit" class="btn btn-primary" data-loading-text="Verifying..." style="width: 100%; margin-top: 0.5rem; padding: 0.75rem;">
        Verify Account &rarr;
      </button>
    </form>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; font-size: 0.88rem; border-top: 1px solid var(--border); padding-top: 1rem;">
      <form action="/auth/resend-otp" method="POST" style="margin: 0;">
        <button type="submit" class="btn btn-secondary btn-sm">Resend Code</button>
      </form>
      <a href="/dashboard" style="color: var(--text-muted); font-size: 0.85rem;">Skip for now &rarr;</a>
    </div>

    <!-- Gmail Setup Tip Box -->
    <div style="margin-top: 1.25rem; background: #f8fafc; border: 1px dashed var(--border); border-radius: var(--radius-sm); padding: 0.85rem; font-size: 0.78rem; color: var(--text-muted); line-height: 1.45;">
      <strong>💡 Gmail Delivery Note:</strong> To deliver real emails to your Gmail inbox, configure your 16-character Google App Password in <code>.env</code> as <code>GMAIL_USER</code> and <code>GMAIL_APP_PASSWORD</code>.
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
