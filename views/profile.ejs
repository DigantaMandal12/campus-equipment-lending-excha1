<%- include('partials/header') %>

<div style="max-width: 820px; margin: 2rem auto;">
  
  <!-- Profile Header Card: Campus Trust & Identity -->
  <div class="card" style="margin-bottom: 1.75rem; padding: 1.75rem; border-top: 4px solid var(--primary); box-shadow: var(--shadow-sm);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.25rem;">
      <div style="display: flex; align-items: center; gap: 1.25rem;">
        <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; border: 2px solid var(--primary-border); flex-shrink: 0;">
          <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--dark); margin: 0;">
              <%= user.name %>
            </h1>
            <span class="role-badge role-<%= user.role %>" style="text-transform: uppercase; font-size: 0.75rem; padding: 0.2rem 0.6rem;">
              <%= user.role %>
            </span>
            <span style="background: #dcfce7; color: #166534; border: 1px solid #86efac; border-radius: 20px; padding: 0.2rem 0.6rem; font-size: 0.75rem; font-weight: 700;">
              ✓ Verified Student
            </span>
          </div>
          <div style="font-size: 0.95rem; color: var(--text-muted); margin-top: 0.25rem;">
            <%= user.college || 'Budge Budge Institute of Technology (BBIT)' %> &bull; <%= user.department || 'Computer Science & Engineering' %>
          </div>
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
            Campus Email: <strong style="color: var(--dark);"><%= user.email %></strong>
          </div>
        </div>
      </div>

      <div>
        <a href="/dashboard" class="btn btn-secondary btn-sm">&larr; Back to Dashboard</a>
      </div>
    </div>
  </div>

  <!-- Trust Rating Overview Section -->
  <div class="trust-card" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
      <div>
        <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.9; font-weight: 800;">
          CAMPUS LENDING TRUST RECORD
        </div>
        <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.35rem;">
          <span class="trust-score-num"><%= user.trustScore ? user.trustScore.toFixed(1) : '5.0' %></span>
          <span style="font-size: 1.4rem; color: #FCD34D;">★★★★★</span>
        </div>
        <div style="font-size: 0.85rem; opacity: 0.9; margin-top: 0.2rem;">
          On-time equipment return & verified peer rating score
        </div>
      </div>
      <div>
        <span style="background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); padding: 0.35rem 0.85rem; border-radius: var(--radius-pill); font-size: 0.8rem; font-weight: 700;">
          🛡️ Gold Standing
        </span>
      </div>
    </div>

    <div class="trust-metrics">
      <div class="trust-metric-box">
        <div class="val"><%= user.successfulBorrows || 0 %></div>
        <div class="lbl">Successful Borrows</div>
      </div>
      <div class="trust-metric-box">
        <div class="val"><%= user.onTimeReturns || 0 %></div>
        <div class="lbl">On-Time Returns</div>
      </div>
      <div class="trust-metric-box">
        <div class="val"><%= user.lateReturns || 0 %></div>
        <div class="lbl">Late / Overdue</div>
      </div>
    </div>
  </div>

  <!-- Edit Profile & Settings Form -->
  <div class="card" style="box-shadow: var(--shadow-md);">
    <div style="border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--dark); margin: 0 0 0.25rem 0;">
        Academic Affiliation & Contact Details
      </h2>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
        Keep your college name, department, and contact information current for pickup coordination
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-box alert-error">
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/profile" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label for="name" class="form-label">Full Name *</label>
          <input type="text" id="name" name="name" class="form-control" value="<%= user.name %>" required>
        </div>

        <div class="form-group">
          <label class="form-label">Campus Email</label>
          <input type="email" class="form-control" value="<%= user.email %>" disabled style="background: #f1f5f9; cursor: not-allowed; color: var(--text-muted);">
          <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 0.25rem;">Verified email address used for login & OTPs.</span>
        </div>
      </div>

      <div class="form-group">
        <label for="college" class="form-label">College / Institute Name *</label>
        <input 
          type="text" 
          id="college" 
          name="college" 
          class="form-control" 
          value="<%= user.college || 'Budge Budge Institute of Technology (BBIT)' %>" 
          placeholder="e.g. Budge Budge Institute of Technology (BBIT)"
          required
        >
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="department" class="form-label">Department *</label>
          <input 
            type="text" 
            id="department" 
            name="department" 
            class="form-control" 
            value="<%= user.department || 'Computer Science & Engineering' %>" 
            placeholder="e.g. Electrical Engineering / CSE / Mechanical"
            required
          >
        </div>

        <div class="form-group">
          <label for="year" class="form-label">Academic Year *</label>
          <select id="year" name="year" class="form-select">
            <option value="1st Year" <%= (user.year === '1st Year') ? 'selected' : '' %>>1st Year (Junior)</option>
            <option value="2nd Year" <%= (user.year === '2nd Year') ? 'selected' : '' %>>2nd Year</option>
            <option value="3rd Year" <%= (user.year === '3rd Year') ? 'selected' : '' %>>3rd Year (Senior)</option>
            <option value="4th Year" <%= (user.year === '4th Year') ? 'selected' : '' %>>4th Year (Senior)</option>
            <option value="Postgraduate" <%= (user.year === 'Postgraduate') ? 'selected' : '' %>>Postgraduate / M.Tech</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="studentId" class="form-label">Student ID / University Roll No.</label>
          <input 
            type="text" 
            id="studentId" 
            name="studentId" 
            class="form-control" 
            value="<%= user.studentId || '' %>"
            placeholder="e.g. 27600125106"
          >
        </div>

        <div class="form-group">
          <label for="phone" class="form-label">Contact Phone / WhatsApp</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            class="form-control" 
            value="<%= user.phone || '' %>"
            placeholder="e.g. +91 98765 43210"
          >
        </div>
      </div>

      <!-- Financial & Deposit Refund Settings -->
      <div style="background: var(--bg-main); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1.25rem; margin: 1.5rem 0 1.25rem 0;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
          <label for="upiId" class="form-label" style="margin: 0; font-weight: 700; color: var(--dark);">
            <span>💳 UPI ID / Virtual Payment Address (VPA)</span>
          </label>
          <span style="font-size: 0.75rem; background: #dcfce7; color: #166534; border: 1px solid #86efac; border-radius: 12px; padding: 0.15rem 0.55rem; font-weight: 700;">
            ✓ Instant Escrow Refunds
          </span>
        </div>

        <input 
          type="text" 
          id="upiId" 
          name="upiId" 
          class="form-control" 
          placeholder="e.g. student@okaxis or 9876543210@paytm" 
          value="<%= user.upiId || '' %>"
          style="font-family: monospace; font-size: 0.95rem;"
        >
        <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-top: 0.4rem; line-height: 1.45;">
          When you return borrowed items in good condition, your security deposit held in campus escrow will be automatically refunded to this UPI address.
        </span>
      </div>

      <div style="margin-top: 1.75rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
        <button type="submit" class="btn btn-primary" data-loading-text="Saving Changes..." style="padding: 0.75rem 1.75rem;">
          Save Profile Changes &rarr;
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
