<%- include('../partials/header') %>

<div style="max-width: 550px; margin: 1.5rem auto;">
  <div class="card" style="box-shadow: var(--shadow-md);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--dark); margin: 0 0 0.4rem 0;">
        Create Campus Account
      </h1>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
        Join students and faculty exchanging academic resources on campus
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-box alert-error">
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Standard Email / Password Registration Form -->
    <form action="/auth/signup" method="POST">
      <div class="form-group">
        <label for="name" class="form-label">Full Name *</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          class="form-control" 
          placeholder="e.g. Alex Morgan" 
          value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>" 
          required
        >
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Campus Email *</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-control" 
          placeholder="student@campus.edu" 
          value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" 
          required
        >
      </div>

      <!-- College / Institute Name -->
      <div class="form-group">
        <label for="college" class="form-label" style="display: flex; justify-content: space-between;">
          <span>College / Institute Name *</span>
          <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: normal;">Your campus</span>
        </label>
        <input 
          type="text" 
          id="college" 
          name="college" 
          class="form-control" 
          placeholder="e.g. Budge Budge Institute of Technology (BBIT)" 
          value="<%= typeof formData !== 'undefined' && formData.college ? formData.college : '' %>" 
          required
        >
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="department" class="form-label">Academic Department</label>
          <select id="department" name="department" class="form-select">
            <option value="Computer Science">Computer Science</option>
            <option value="Electrical & Electronics">Electrical & Electronics</option>
            <option value="Mechanical Engineering">Mechanical Engineering</option>
            <option value="Civil Engineering">Civil Engineering</option>
            <option value="Physics & Chemistry">Physics & Chemistry</option>
            <option value="Biotechnology">Biotechnology</option>
            <option value="Mathematics">Mathematics</option>
            <option value="General">General Campus</option>
          </select>
        </div>

        <div class="form-group">
          <label for="year" class="form-label">Academic Year</label>
          <select id="year" name="year" class="form-select">
            <option value="1st Year (Junior)">1st Year (Junior Student)</option>
            <option value="2nd Year">2nd Year</option>
            <option value="3rd Year (Senior)">3rd Year (Senior / Lender)</option>
            <option value="4th Year (Senior)">4th Year (Senior / Lender)</option>
            <option value="Postgraduate / PhD">Postgraduate / PhD</option>
            <option value="Faculty / Staff">Faculty / Staff</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="role" class="form-label">Role</label>
          <select id="role" name="role" class="form-select" onchange="toggleAdminCode(this.value)">
            <option value="student">Student (Borrower / Lender)</option>
            <option value="teacher">Faculty / Teacher</option>
            <option value="admin">Campus Administrator</option>
          </select>
        </div>

        <div class="form-group">
          <label for="studentId" class="form-label">Student ID / Roll No.</label>
          <input 
            type="text" 
            id="studentId" 
            name="studentId" 
            class="form-control" 
            placeholder="e.g. 2026-CS-041" 
            value="<%= typeof formData !== 'undefined' && formData.studentId ? formData.studentId : '' %>"
          >
        </div>
      </div>

      <div id="adminCodeGroup" class="form-group" style="display: none;">
        <label for="adminCode" class="form-label">Admin Invite Code *</label>
        <input type="password" id="adminCode" name="adminCode" class="form-control" placeholder="Enter administrator authorization code">
      </div>

      <div class="form-group">
        <label for="phone" class="form-label">Phone Number (Optional)</label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          class="form-control" 
          placeholder="e.g. 9876543210" 
          value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
        >
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="password" class="form-label">Password * (Min 6 chars)</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="Create password" required autocomplete="new-password">
        </div>

        <div class="form-group">
          <label for="confirmPassword" class="form-label">Confirm Password *</label>
          <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Repeat password" required autocomplete="new-password">
        </div>
      </div>

      <button type="submit" class="btn btn-primary" data-loading-text="Creating Account..." style="width: 100%; margin-top: 0.5rem; padding: 0.75rem;">
        Register Account
      </button>
    </form>

    <!-- Visual OR Divider -->
    <div class="auth-divider">
      <span>OR</span>
    </div>

    <!-- Social Authentication Buttons -->
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <!-- Google Sign Up Button -->
      <a href="/auth/google" class="btn-social btn-google" id="btnGoogleSignup" title="Sign up with your Google account">
        <svg width="20" height="20" viewBox="0 0 48 48" style="display: block; flex-shrink: 0;">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          <path fill="none" d="M0 0h48v48H0z"/>
        </svg>
        <span>Continue with Google</span>
      </a>

      <!-- Facebook Sign Up Button -->
      <a href="/auth/facebook" class="btn-social btn-facebook" id="btnFacebookSignup" title="Sign up with your Facebook account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display: block; flex-shrink: 0;">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        <span>Continue with Facebook</span>
      </a>
    </div>

    <!-- Login Link -->
    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; border-top: 1px solid var(--border); padding-top: 1rem;">
      <span style="color: var(--text-muted);">Already have an account?</span>
      <a href="/auth/login" style="font-weight: 700; color: var(--primary); margin-left: 0.35rem;">Sign In</a>
    </div>
  </div>
</div>

<script>
  function toggleAdminCode(val) {
    const group = document.getElementById('adminCodeGroup');
    if (val === 'admin') {
      group.style.display = 'block';
    } else {
      group.style.display = 'none';
    }
  }
</script>

<%- include('../partials/footer') %>
