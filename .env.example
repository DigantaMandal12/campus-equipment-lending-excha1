# ==============================================================================
# Campus Equipment Lending Exchange - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection: Firebase Realtime Database
# Runs within Firebase's no-cost Spark plan (1 GB storage quota, no Blaze billing required)
FIREBASE_PROJECT_ID=campus-equipment-exchange
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@campus-equipment-exchange.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://campus-equipment-exchange-default-rtdb.firebaseio.com
FIREBASE_DATABASE_SECRET=

# Session Security & Edge Cookie Settings
SESSION_SECRET=supersecretcampuslendingkey_change_in_production
COOKIE_SECURE=false

# Google OAuth 2.0 Credentials (Google Cloud Console Web Client)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
# Production redirect URI: https://YOUR-VERCEL-DOMAIN.vercel.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Facebook / Meta Login Credentials (Meta for Developers)
# Authorized redirect URI: http://localhost:3000/auth/facebook/callback
# Production redirect URI: https://YOUR-VERCEL-DOMAIN.vercel.app/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# Gmail OTP Configuration (Required to send real OTP emails)
# 1. Enable 2-Step Verification in Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Campus UPI Payment Gateway Settings
DEFAULT_UPI_ID=campus.equipment@icici
UPI_MERCHANT_NAME=Campus Equipment Exchange

# OpenRouter AI Configuration (Activate live LLM neural responses)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Application & Administration Settings
AI_ASSISTANT_NAME=Campus Equipment Advisor
ADMIN_INVITE_CODE=CAMPUS_ADMIN_SECURE_2026
