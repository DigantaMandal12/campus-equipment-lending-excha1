<%- include('partials/header') %>

<!-- Dashboard Header -->
<div class="page-header">
  <div>
    <h1 class="page-title">Hello, <%= currentUser.name.split(' ')[0] %> 👋</h1>
    <p class="page-subtitle"><%= currentUser.college || 'Campus Member' %> &bull; <%= currentUser.department %> (<%= currentUser.role.toUpperCase() %>)</p>
  </div>
  <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
    <a href="/equipment/add" class="btn btn-primary">+ List Equipment</a>
    <a href="/borrow/requests" class="btn btn-secondary">📦 Orders & Requests</a>
    <a href="/search" class="btn btn-secondary">🔍 Browse Catalog</a>
  </div>
</div>

<!-- 7. Trust Score & Verification Card -->
<div class="trust-card" style="margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.9; font-weight: 700;">
        CAMPUS TRUST RATING
      </div>
      <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.35rem;">
        <span class="trust-score-num"><%= currentUser.trustScore ? currentUser.trustScore.toFixed(1) : '5.0' %></span>
        <span style="font-size: 1.5rem; color: #FCD34D;">★★★★★</span>
      </div>
      <div style="font-size: 0.85rem; opacity: 0.9; margin-top: 0.25rem;">
        Verified Campus Student &bull; On-time return reliability score
      </div>
    </div>
    <div>
      <span style="background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); padding: 0.35rem 0.85rem; border-radius: var(--radius-pill); font-size: 0.8rem; font-weight: 700;">
        🛡️ Good Academic Standing
      </span>
    </div>
  </div>

  <div class="trust-metrics">
    <div class="trust-metric-box">
      <div class="val"><%= currentUser.successfulBorrows || activeLoans.length || 0 %></div>
      <div class="lbl">Successful Borrows</div>
    </div>
    <div class="trust-metric-box">
      <div class="val"><%= currentUser.onTimeReturns || 0 %></div>
      <div class="lbl">On-Time Returns</div>
    </div>
    <div class="trust-metric-box">
      <div class="val"><%= currentUser.lateReturns || 0 %></div>
      <div class="lbl">Late / Overdue</div>
    </div>
  </div>
</div>

<!-- 4. Overview Statistics -->
<div class="stat-grid">
  <div class="card card-hover" style="border-left: 4px solid var(--primary);">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">My Equipment</div>
    <div style="font-size: 1.8rem; font-weight: 800; color: var(--dark); margin: 0.25rem 0;"><%= myItems.length %></div>
    <div style="font-size: 0.82rem; color: var(--text-muted);">Listed in catalog</div>
  </div>

  <div class="card card-hover" style="border-left: 4px solid var(--secondary);">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Active Loans & Borrows</div>
    <div style="font-size: 1.8rem; font-weight: 800; color: var(--dark); margin: 0.25rem 0;"><%= activeLoans.length %></div>
    <div style="font-size: 0.82rem; color: var(--text-muted);">Currently in fulfillment</div>
  </div>

  <div class="card card-hover" style="border-left: 4px solid var(--warning);">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Orders to Prepare</div>
    <div style="font-size: 1.8rem; font-weight: 800; color: var(--warning); margin: 0.25rem 0;"><%= pendingIncomingRequests.length %></div>
    <div style="font-size: 0.82rem; color: var(--text-muted);">Awaiting your action</div>
  </div>

  <div class="card card-hover" style="border-left: 4px solid var(--success);">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">My Sent Orders</div>
    <div style="font-size: 1.8rem; font-weight: 800; color: var(--dark); margin: 0.25rem 0;"><%= pendingMyRequests.length %></div>
    <div style="font-size: 0.82rem; color: var(--text-muted);">Gear requested</div>
  </div>
</div>

<!-- 6. Borrow Status Timeline Reference (How peer lending progresses) -->
<div class="card" style="margin-bottom: 2rem;">
  <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--dark); margin-bottom: 0.5rem;">
    Lending Lifecycle Status Flow
  </h2>
  <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem;">
    Every borrowing transaction moves smoothly through 4 monitored phases:
  </p>

  <div class="borrow-timeline">
    <div class="timeline-step completed">
      <div class="timeline-dot">1</div>
      <div class="timeline-label">Request Sent</div>
    </div>
    <div class="timeline-step completed">
      <div class="timeline-dot">2</div>
      <div class="timeline-label">Senior Approval</div>
    </div>
    <div class="timeline-step active">
      <div class="timeline-dot">3</div>
      <div class="timeline-label">Campus Pickup</div>
    </div>
    <div class="timeline-step">
      <div class="timeline-dot">4</div>
      <div class="timeline-label">Return & Refund</div>
    </div>
  </div>
</div>

<!-- Incoming Requests Awaiting Action (Seller / Lender View) -->
<% if (pendingIncomingRequests.length > 0) { %>
  <div class="card" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--dark); margin: 0;">
          🔔 Orders Awaiting Your Preparation & Handover
        </h2>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0.15rem 0 0 0;">
          Peer students waiting for pickup confirmation
        </p>
      </div>
      <a href="/borrow/requests" class="btn btn-secondary btn-sm">Manage All Orders &rarr;</a>
    </div>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Order & Item</th>
            <th>Junior Borrower</th>
            <th>Pickup Location</th>
            <th>Date & Slot</th>
            <th>Status</th>
            <th>Quick Actions</th>
          </tr>
        </thead>
        <tbody>
          <% pendingIncomingRequests.forEach(function(reqItem) { %>
            <tr>
              <td>
                <div style="font-family: monospace; font-size: 0.78rem; font-weight: 700; color: var(--primary);">
                  #<%= reqItem.orderNumber || 'ORD-' + reqItem._id.toString().slice(-5).toUpperCase() %>
                </div>
                <strong><%= reqItem.equipment ? reqItem.equipment.title : 'Deleted item' %></strong>
              </td>
              <td>
                <strong><%= reqItem.borrower ? reqItem.borrower.name : 'Student' %></strong>
                <div style="font-size: 0.78rem; color: var(--text-muted);"><%= reqItem.borrower ? reqItem.borrower.department : '' %></div>
              </td>
              <td style="font-size: 0.85rem;">
                📍 <%= reqItem.pickupLocation || 'Electrical Lab - Room 304' %>
              </td>
              <td style="font-size: 0.85rem;">
                <strong><%= new Date(reqItem.pickupDate || reqItem.startDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></strong>
                <div style="color: var(--secondary); font-size: 0.78rem;"><%= reqItem.pickupTime || '2:00 PM – 2:30 PM' %></div>
              </td>
              <td>
                <% if (reqItem.handoverStatus === 'READY_FOR_PICKUP') { %>
                  <span class="status-badge status-available">Ready for Pickup</span>
                <% } else if (reqItem.handoverStatus === 'PREPARING') { %>
                  <span class="status-badge status-approved">Preparing</span>
                <% } else { %>
                  <span class="status-badge status-pending">New Request</span>
                <% } %>
              </td>
              <td>
                <div style="display: flex; gap: 0.4rem;">
                  <% if (reqItem.status === 'PENDING') { %>
                    <form action="/borrow/approve" method="POST" style="margin: 0;">
                      <input type="hidden" name="requestId" value="<%= reqItem._id %>">
                      <button type="submit" class="btn btn-success btn-sm" data-loading-text="Accepting...">Accept</button>
                    </form>
                    <form action="/borrow/reject" method="POST" style="margin: 0;">
                      <input type="hidden" name="requestId" value="<%= reqItem._id %>">
                      <button type="submit" class="btn btn-danger btn-sm" data-confirm="Decline this order?" data-loading-text="Declining...">Reject</button>
                    </form>
                  <% } else { %>
                    <a href="/borrow/requests" class="btn btn-secondary btn-sm">Manage</a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- My Equipment Inventory -->
<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
    <div>
      <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--dark); margin: 0;">My Listed Equipment</h2>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0.15rem 0 0 0;">Items you share with junior students</p>
    </div>
    <a href="/equipment/add" class="btn btn-primary btn-sm">+ Add New Item</a>
  </div>

  <% if (myItems.length > 0) { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Equipment Name</th>
            <th>Category</th>
            <th>Condition</th>
            <th>Status</th>
            <th>Fee & Deposit</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% myItems.forEach(function(item) { %>
            <tr>
              <td>
                <strong><a href="/equipment/<%= item._id %>"><%= item.title %></a></strong>
                <div style="font-size: 0.78rem; color: var(--text-muted);"><%= item.department %></div>
              </td>
              <td><%= item.category %></td>
              <td><%= item.condition %></td>
              <td>
                <span class="status-badge <%= item.status === 'AVAILABLE' ? 'status-available' : (item.status === 'BORROWED' ? 'status-borrowed' : 'status-unavailable') %>">
                  <%= item.status === 'AVAILABLE' ? 'Available' : (item.status === 'BORROWED' ? 'Borrowed' : item.status) %>
                </span>
              </td>
              <td style="font-size: 0.85rem;">
                <div><%= item.dailyFee > 0 ? '₹' + item.dailyFee + '/day' : 'Free' %></div>
                <div style="color: var(--text-muted); font-size: 0.78rem;"><%= item.depositAmount > 0 ? 'Dep: ₹' + item.depositAmount : 'Zero Dep' %></div>
              </td>
              <td>
                <div style="display: flex; gap: 0.35rem;">
                  <a href="/equipment/<%= item._id %>" class="btn btn-secondary btn-sm">View</a>
                  <a href="/equipment/<%= item._id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                  <form action="/equipment/<%= item._id %>/delete" method="POST" style="display: inline; margin: 0;">
                    <button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure you want to delete this equipment?" data-loading-text="Deleting...">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">📚</div>
      <h3 class="empty-title">You have not listed any equipment yet</h3>
      <p class="empty-desc">Help 1st-year students by listing your unused mini drafter, drawing board, multimeter, or calculator.</p>
      <a href="/equipment/add" class="btn btn-primary">+ List First Item</a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
